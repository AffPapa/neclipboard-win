<Window x:Class="NeClipboardWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeClipboard Win" Height="500" Width="460" MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Root" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Root" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="12,10" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Padding" Value="13,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Choice" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}" /><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" /></Border></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="7" MinWidth="130"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border></Popup>
                    <Border x:Name="ComboFocus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainLayoutGrid" Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Margin="0,0,12,0">
                    <Viewbox Margin="10"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="5" Canvas.Top="6" Width="14" Height="14" RadiusX="2.5" RadiusY="2.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.9" /><Line X1="8" Y1="4" X2="16" Y2="4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="8.5" Y1="12" X2="15.5" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="8.5" Y1="15.5" X2="13.4" Y2="15.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="NeClipboard Win" FontSize="19" FontWeight="SemiBold" /><TextBlock x:Name="CaptureStateText" Text="Локальная история буфера" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="HotkeyBadgeBorder" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Padding="11,7" CornerRadius="8" Margin="0,0,7,0"><TextBlock x:Name="HotkeyBadge" Text="Ctrl + Shift + V" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" /></Border>
                <Button x:Name="ModeButton" Content="Настройки" Click="ModeButton_Click" ToolTip="Открыть полное окно" />
                <Button x:Name="HideButton" Content="В трей" Click="HideButton_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="SearchPanel" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
            <Grid x:Name="SearchGrid">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="142" /></Grid.ColumnDefinitions>
                <Path Data="M15,15 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 M19,19 L23,23" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="24" Height="24" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder" Text="Поиск по истории" Foreground="{DynamicResource SubtleTextBrush}" FontSize="13" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Поиск по истории" Margin="36,1,6,1" Height="40" FontSize="13" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по полному тексту, типу и приложению" />
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" FontSize="17" Padding="8,0" AutomationProperties.Name="Очистить поиск" ToolTip="Очистить поиск (Esc)" Click="ClearSearchButton_Click" Visibility="Collapsed" />
                <ComboBox x:Name="HistoryFilterBox" Grid.Column="2" Margin="4" AutomationProperties.Name="Фильтр истории" SelectedIndex="0" SelectionChanged="HistoryFilterBox_SelectionChanged"><ComboBoxItem Content="Всё" /><ComboBoxItem Content="Текст" /><ComboBoxItem Content="Изображения" /><ComboBoxItem Content="Файлы" /><ComboBoxItem Content="Закреплённое" /></ComboBox>
            </Grid>
        </Border>

        <Border x:Name="ContentBorder" Grid.Row="2" Margin="0,8,0,6" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
            <TabControl x:Name="MainTabs" KeyboardNavigation.TabNavigation="Once" Background="Transparent" BorderThickness="0" Padding="10,8" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="История">
                    <Grid Margin="3,9,3,1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <ListBox x:Name="HistoryList" AutomationProperties.Name="История буфера" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding FilteredEntries}" SelectionChanged="HistoryList_SelectionChanged" MouseDoubleClick="HistoryList_MouseDoubleClick">
                                <ListBox.ItemTemplate><DataTemplate><Grid AutomationProperties.Name="{Binding AccessibleSummary}"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource IconSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" /></Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,12,0"><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding TimestampText}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Right" /><TextBlock Text="Закреплено" Foreground="{DynamicResource PinnedBrush}" FontSize="10" HorizontalAlignment="Right" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" /></StackPanel>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="HistoryEmptyState" Background="{DynamicResource SurfaceMutedBrush}" Padding="28" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="HistoryEmptyTitle" Text="История пока пуста" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock x:Name="HistoryEmptyDescription" Text="Скопируйте текст, файл или изображение — оно появится здесь." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Margin="0,8,0,0" /><Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Padding="11,7" CornerRadius="8" Margin="0,16,0,0" HorizontalAlignment="Center"><TextBlock x:Name="EmptyHotkeyBadge" Text="Ctrl + Shift + V" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Border></StackPanel></Border>
                        </Grid>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="PinButton" Content="Закрепить" Click="PinButton_Click" /><Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource DangerButton}" Click="DeleteButton_Click" /><Button x:Name="PasteButton" Content="Скопировать" Style="{StaticResource PrimaryButton}" Click="PasteButton_Click" /></WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Сниппеты">
                    <Grid Margin="3,9,3,1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListBox x:Name="SnippetList" AutomationProperties.Name="Заготовки текста" SelectionChanged="SnippetList_SelectionChanged" MouseDoubleClick="SnippetList_MouseDoubleClick"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="{Binding Content}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxHeight="20" FontSize="11" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <TextBlock Text="Заготовки текста для повторной вставки.&#x0a;Нажмите «Добавить», чтобы создать первую." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SnippetList}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Добавить" Click="AddSnippetButton_Click" /><Button x:Name="EditSnippetButton" Content="Изменить" Click="EditSnippetButton_Click" /><Button x:Name="DeleteSnippetButton" Content="Удалить" Style="{StaticResource DangerButton}" Click="DeleteSnippetButton_Click" /><Button x:Name="PasteSnippetButton" Content="Скопировать" Style="{StaticResource PrimaryButton}" Click="PasteSnippetButton_Click" /></WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="SettingsTab" Header="Настройки">
                    <ScrollViewer Margin="8,13,8,1" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="610">
                        <CheckBox x:Name="CaptureEnabledCheckBox" Content="Сохранять новые элементы буфера" Margin="0,0,0,15" />
                        <CheckBox x:Name="StartupCheckBox" Margin="0,0,0,15"><TextBlock Text="Запускать при входе в Windows — тихо в трее" TextWrapping="Wrap" /></CheckBox>
                        <CheckBox x:Name="AutoPasteCheckBox" Margin="0,0,0,17"><TextBlock Text="Автоматически вставлять в предыдущее окно (экспериментально)" TextWrapping="Wrap" /></CheckBox>
                        <TextBlock Text="Горячая клавиша" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        <TextBox x:Name="HotkeyTextBox" AutomationProperties.Name="Горячая клавиша — нажмите новое сочетание" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Width="220" HorizontalAlignment="Left" Margin="0,6,0,5" />
                        <TextBlock Text="Нажмите Ctrl или Alt с буквой, цифрой или F1–F11. Затем сохраните." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,17" />
                        <TextBlock Text="Максимум элементов (10–1000, включая закреплённые)" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                        <TextBox x:Name="MaxHistoryTextBox" AutomationProperties.Name="Максимум элементов истории" Width="130" HorizontalAlignment="Left" Margin="0,6,0,17" />
                        <TextBlock Text="Исключения — имена приложений .exe через запятую" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <TextBox x:Name="ExcludedAppsTextBox" AutomationProperties.Name="Исключённые приложения" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,15" />
                        <WrapPanel><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" /><Button Content="Очистить историю" Style="{StaticResource DangerButton}" Click="ClearButton_Click" /></WrapPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,18,0,0"><StackPanel>
                            <TextBlock Text="Резервная копия" FontWeight="SemiBold" />
                            <TextBlock Text="История, сниппеты и настройки — для этой учётной записи Windows на этом компьютере. Копия не предназначена для переноса на другой ПК. Восстановление заменит текущие данные." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" />
                            <WrapPanel><Button Content="Создать копию" Click="CreateBackupButton_Click" /><Button Content="Восстановить копию" Click="RestoreBackupButton_Click" /></WrapPanel>
                        </StackPanel></Border>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="3,15,0,0" />
                        <TextBlock Text="Данные локальны и защищены Windows DPAPI. Файлы из буфера сохраняются как пути: содержимое самих файлов в копию не входит." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="3,5,0,8" />
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" Grid.ColumnSpan="2" AutomationProperties.LiveSetting="Polite" Text="Готово к работе" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="ShortcutHints" Grid.Row="1" Text="Esc — скрыть · Enter — скопировать · Delete — удалить" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6,8,0" />
            <Button x:Name="PauseButton" Grid.Row="1" Grid.Column="1" Content="Пауза 15 мин" Click="PauseButton_Click" Margin="3,6,0,0" />
        </Grid>
    </Grid>
</Window>
